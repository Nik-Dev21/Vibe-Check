# ============================================================
#  VibeCheck — .env.example
#  Copy this to .env.local and fill in your values.
#  This file IS safe to commit — it contains no real secrets.
# ============================================================

# CLAUDE (primary scanner — Anthropic Haiku 4.5)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# IBM CLOUD OBJECT STORAGE (full report storage)
IBM_COS_API_KEY=
IBM_COS_INSTANCE_CRN=
IBM_COS_ENDPOINT=
IBM_COS_BUCKET_NAME=vibecheck-scan-reports

# IBM CLOUDANT (scan status + summary)
IBM_CLOUDANT_API_KEY=
IBM_CLOUDANT_URL=
IBM_CLOUDANT_DB_NAME=vibecheck-scans

# FEATHERLESS AI (optional second-opinion pass on HIGH-risk files)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# GITHUB INTEGRATION
GITHUB_TOKEN=

# GITHUB OAUTH (for NextAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NEXT.JS
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
