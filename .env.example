# ============================================================
#  VibeCheck — .env.example
#  Copy this to .env.local and fill in your values.
#  This file IS safe to commit — it contains no real secrets.
# ============================================================

# WATSONX.AI
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-34b-code-instruct

# IBM IAM
IBM_IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token

# WATSON NLU
WATSON_NLU_API_KEY=
WATSON_NLU_URL=

# IBM CLOUD OBJECT STORAGE
IBM_COS_API_KEY=
IBM_COS_INSTANCE_CRN=
IBM_COS_ENDPOINT=
IBM_COS_BUCKET_NAME=vibecheck-scan-reports

# IBM CLOUDANT
IBM_CLOUDANT_API_KEY=
IBM_CLOUDANT_URL=
IBM_CLOUDANT_DB_NAME=vibecheck-scans

# FEATHERLESS AI
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# GITHUB INTEGRATION
GITHUB_TOKEN=

# GITHUB OAUTH (for NextAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NEXT.JS
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
